import numpy as np
import matplotlib.pyplot as plt

x1 = np.linspace(0, 5, 500)

y_1 = 4 - x1           x2 <= 4 - x1
y_2 = 3 - 3 * x1       x2 >= 3 - 3x1
y_3 = 1 - 0.2 * x1     x2 >= 1 - 0.2x1
y_nonneg = np.zeros_like(x1) x2 >= 0

x2 <= 4 - x1
y_upper = y_1

x2 >= max(y_2, y_3, 0)
y_lower = np.maximum.reduce([y_2, y_3, y_nonneg])

plt.figure(figsize=(7, 7))
plt.title('(1б)')
plt.xlabel('X1')
plt.ylabel('X2')
plt.xlim(0, 5)
plt.ylim(0, 5)
plt.grid(True)

plt.plot(x1, y_1, label=r'$x_1 + x_2 = 4$')
plt.plot(x1, y_2, label=r'$6x_1 + 2x_2 = 6$')
plt.plot(x1, y_3, label=r'$x_1 + 5x_2 = 5$')

plt.fill_between(x1, y_lower, y_upper, where=y_upper >= y_lower, 
                 color='blue', alpha=0.5, label='ОДР')

plt.legend()
plt.show()
